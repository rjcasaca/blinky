<Application x:Class="Blinky.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#EDEEF3" />
    <SolidColorBrush x:Key="Muted" Color="#9399AD" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EDEEF3"/><Setter Property="Background" Value="#30364B"/>
      <Setter Property="Padding" Value="16,10"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Native dropdowns have light surfaces. Let generated TextBlocks inherit
         their control's foreground instead of forcing the window's white ink. -->
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#172033"/>
      <Setter Property="Background" Value="#F4F5F9"/>
      <Setter Property="Margin" Value="0,7,0,16"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#172033"/>
      <Setter Property="Background" Value="#F4F5F9"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#DEE8FF"/></Trigger>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#C9DAFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#626B7C"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D9DCE8"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
    <Style TargetType="ProgressBar"><Setter Property="Height" Value="5"/><Setter Property="Maximum" Value="1"/><Setter Property="Background" Value="#30364B"/><Setter Property="Foreground" Value="#8ADAAC"/><Setter Property="BorderThickness" Value="0"/></Style>
  </Application.Resources>
</Application>
